import Src from '../components/Src.astro';
import Aff from '../components/Aff.astro';
import Unverified from '../components/Unverified.astro';
import { S } from '../data/sources.js';
const title = 'Anytime Mailbox Pricing: Why It Ranges From $4.99 to $99.99 a Month';
const description = 'We read the starting price of all 2,095 U.S. Anytime Mailbox locations: median $10.99, about half at $9.99 or less, one at $4.99. Why prices differ, and what the plans at five real locations include.';
const schema = {"@context":"https://schema.org","@type":"Article","headline":title,"description":description,"dateModified":"2026-11-20"};
---
<Base title={title} description={description} updated="2026-11-20" schema={schema}>
  <h1>Anytime Mailbox pricing: why it ranges so widely</h1>
  <p class="lede">Anytime Mailbox doesn't have one price list. Each location is run by an independent mail center operator who sets their own plans and per-item fees. So "from $9.99" can mean 15 or 100 items a month, and $0.18 or $1.00 per scanned page. On November 20, 2026 we read the "starting from" price of every U.S. location on Anytime Mailbox's state pages, and the full plans at five of them.</p>

  <h2>What Anytime Mailbox itself says</h2>
  <ul>
    <li>"Our cheapest virtual mailbox plans are $4.99. On average, our plans cost $9.99 per month. Some of our vanity addresses can cost up to $50" <Src href={S.atm} /></li>
    <li>"All service plans show what the included services are for each plan before you sign up, and what the fees are for any additional actions you request beyond your chosen plan from your mail center operator" <Src href={S.atm} /></li>
    <li>Each location page names its "Mail Center Operator" <Src href={S.atmArlington} /></li>
  </ul>

  <h2>Starting prices across all U.S. locations</h2>
  <p>The state pages list 2,095 U.S. locations with a "Starting from" price <Src href={S.atmLocations} label="locations" />. 2,089 quote a monthly price. Six quote only a yearly price (covered below). For the 2,089 monthly prices:</p>
  <div class="tablewrap"><table>
    <thead><tr><th>Starting price</th><th>Locations</th><th>Share</th></tr></thead>
    <tbody>
      <tr><td>Under $8.00</td><td>26</td><td>1.2%</td></tr>
      <tr><td>$8.00–$9.99</td><td>1,001</td><td>47.9%</td></tr>
      <tr><td>$10.00–$14.99</td><td>652</td><td>31.2%</td></tr>
      <tr><td>$15.00–$19.99</td><td>214</td><td>10.2%</td></tr>
      <tr><td>$20.00–$50.00</td><td>167</td><td>8.0%</td></tr>
      <tr><td>Over $50.00</td><td>29</td><td>1.4%</td></tr>
    </tbody>
  </table></div>
  <ul>
    <li>The median is <strong>$10.99</strong>. Exactly $9.99 is the most common price, at 944 locations.</li>
    <li>We found only one $4.99 location: Arlington, VA (1550 Wilson Blvd) <Src href={S.atmArlington} />. The next cheapest was $5.99, in Fort Walton Beach, FL.</li>
    <li>The highest monthly starting price was $99.99, in Denver (Fiddlers Green Cir). 29 locations start above the "up to $50" mentioned in the FAQ.</li>
  </ul>
  <p class="meta">Method: we parsed the location cards on each of Anytime Mailbox's U.S. state pages on 2026-11-20. Counts are a snapshot, and the site's own location count can differ slightly from the number of cards shown.</p>

  <h3>Cheapest and median starting price by state</h3>
  <div class="tablewrap"><table>
    <thead><tr><th>State</th><th>Locations (monthly-priced)</th><th>Cheapest</th><th>Median</th><th>Highest</th></tr></thead>
    <tbody>
      <tr><td>California</td><td>396</td><td>$7.99</td><td>$9.99</td><td>$75.00</td></tr>
      <tr><td>Texas</td><td>290</td><td>$7.99</td><td>$11.99</td><td>$59.99</td></tr>
      <tr><td>Florida</td><td>242</td><td>$5.99</td><td>$10.49</td><td>$69.00</td></tr>
      <tr><td>Georgia</td><td>100</td><td>$7.99</td><td>$10.99</td><td>$49.99</td></tr>
      <tr><td>New York</td><td>96</td><td>$8.99</td><td>$11.99</td><td>$84.99</td></tr>
      <tr><td>Nevada</td><td>47</td><td>$7.99</td><td>$9.99</td><td>$49.99</td></tr>
      <tr><td>Massachusetts</td><td>22</td><td>$8.99</td><td>$11.99</td><td>$49.99</td></tr>
      <tr><td>Delaware</td><td>18</td><td>$6.99</td><td>$9.99</td><td>$15.99</td></tr>
      <tr><td>Wyoming</td><td>6</td><td>$7.99</td><td>$9.99</td><td>$19.99</td></tr>
