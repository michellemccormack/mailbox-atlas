---
import Base from '../layouts/Base.astro';
import Src from '../components/Src.astro';
import Aff from '../components/Aff.astro';
import Unverified from '../components/Unverified.astro';
import { S } from '../data/sources.js';
const title = 'Virtual Mailbox Pricing Compared: Plans, Scan Fees and Form 1583 (2026)';
const description = 'Eight virtual mailbox services side by side: monthly price, mail included, scan and overage fees, forwarding fees, and whether you need a notary for USPS Form 1583. Every number links to the provider page it came from.';
const schema = {"@context":"https://schema.org","@type":"Article","headline":title,"description":description,"dateModified":"2026-11-19"};
---
<Base title={title} description={description} schema={schema}>
  <h1>Virtual mailbox pricing, compared</h1>
  <p class="lede">The sticker price is the smallest part of the bill. What decides the real cost is how many pieces of mail are included, what each scan past that costs, and what forwarding costs. Here are the published numbers for eight services, copied from each provider's own page on November 19, 2026.</p>

  <div class="note"><strong>How to read this:</strong> "from" prices vary by location for iPostal1, Anytime Mailbox and PostScan Mail, because independent mail centers set them. The table shows the lowest price each provider advertises. Annual billing is cheaper at several providers, and both prices are shown where the page lists both.</div>

  <h2>Entry plans side by side</h2>
  <div class="tablewrap"><table>
    <thead><tr><th>Provider</th><th>Cheapest plan (as published)</th><th>Mail included</th><th>Scans / overage</th><th>Forwarding</th><th>Form 1583 signing</th></tr></thead>
    <tbody>
      <tr><td><strong>Anytime Mailbox</strong></td>
        <td>"Our cheapest virtual mailbox plans are $4.99"; average $9.99/mo; prestige addresses up to $50 <Src href={S.atm} /></td>
        <td>Set per location and plan <Src href={S.atm} /></td>
        <td>Shown per plan before signup, set by the mail center <Src href={S.atm} /></td>
        <td>Set by the mail center <Unverified note="not published centrally" /></td>
        <td>Notarized; optional built-in online notary video call <Src href={S.atmFaq} /></td></tr>
      <tr><td><strong>iPostal1</strong></td>
        <td>Virtual Mailing Address from $9.99/mo; Virtual Business Address from $14.99/mo; Virtual Office from $39.99/mo <Src href={S.ip} /></td>
        <td>$9.99 plan: 30 items a month, personal use only (rechecked 2026-11-20) <Src href={S.ipVma} /></td>
        <td>$0.35 per extra item; open &amp; scan $2.25 per envelope up to 10 pages <Src href={S.ipVma} /></td>
        <td>Live shipping rates; letter consolidation free <Src href={S.ipVma} /></td>
        <td>Notarized: online notary $25, or sign in person at many mail centers <Src href={S.ipFaq} /></td></tr>
      <tr><td><strong>Traveling Mailbox</strong></td>
        <td>Basic $15/mo; Extended $25/mo; Small Business $55/mo <Src href={S.tmb} /></td>
        <td>Basic: 40 envelopes and 35 page scans a month; junk mail doesn't count <Src href={S.tmb} /></td>
        <td>$0.25 per extra envelope, $0.50 per extra page scan <Src href={S.tmb} /></td>
        <td>Postage + $2 per shipment (not per piece) <Src href={S.tmb} /></td>
        <td>Video call with Traveling Mailbox staff; "A notary is not required" <Src href={S.tmbKb} /></td></tr>
      <tr><td><strong>PostScan Mail</strong></td>
        <td>Starter "as low as $10/mo" (monthly) or $8.33/mo billed annually <Src href={S.psm} /></td>
        <td>Starter: 30 items a month, 1 recipient <Src href={S.psm} /></td>
        <td>$0.50 per extra envelope/package scan; open &amp; scan $2.00 per envelope up to 10 pages <Src href={S.psm} /></td>
        <td>$2.00 first item, $0.50 each additional, plus shipping <Src href={S.psm} /></td>
        <td>Notarized: partner online notary for $20 <Src href={S.psmFaq} /></td></tr>
      <tr><td><strong>Earth Class Mail</strong> (now LegalZoom Virtual Mail)</td>
        <td>Starter MailBox $39/mo; Essentials $59/mo; Premium $119/mo <Src href={S.ecm} /></td>
        <td>Starter: 5 mail items digitized a month, junk excluded <Src href={S.ecm} /></td>
        <td>No extra charge for documents of 20 pages or less <Src href={S.ecm} /></td>
        <td>From $1.25 per shipment plus postage <Src href={S.ecm} /></td>
        <td>Self-verify online, or a video call with partner online notary <Src href={S.ecm1583} /></td></tr>
      <tr><td><strong>Stable</strong></td>
        <td>Grow $59/mo monthly or $49/mo billed yearly; Scale $99/mo or $83/mo yearly <Src href={S.stable} /></td>
        <td>Grow: 30 pieces a month (360/yr on yearly); junk excluded <Src href={S.stable} /></td>
        <td>Open &amp; scan free; $3 per piece over the plan limit <Src href={S.stable} /></td>
        <td>Postage cost (add-on) <Src href={S.stable} /></td>
        <td>No notary; Stable verifies your IDs in-house <Src href={S.stable1583} /></td></tr>
      <tr><td><strong>US Global Mail</strong></td>
        <td>Scale $65/mo monthly or $49/mo billed annually; Teams $129/mo or $99/mo <Src href={S.usgm} /></td>
        <td>Scale: 360 envelopes opened and scanned a year, 10 recipients <Src href={S.usgm} /></td>
        <td>Scanning included, subject to fair use <Src href={S.usgm} /></td>
        <td>Not captured <Unverified /></td>
        <td>"No need to find a notary separately" <Src href={S.usgm1583} /></td></tr>
