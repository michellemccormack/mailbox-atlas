---
// Inline citation link. Every factual claim should carry one.
const { href, label = 'source' } = Astro.props;
const isAffiliate = typeof href === 'string' && /^https:\/\/(www\.)?(usglobalmail\.com|travelingmailbox\.com)([/?#]|$)/.test(href);
const rel = isAffiliate ? 'sponsored nofollow noopener' : 'noopener';
---
<a class="src" href={href} target="_blank" rel={rel}>[{label}]</a>
