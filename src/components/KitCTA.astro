---
const name = 'Business Address Switch Kit';
const price = '$19';
const blurb = 'A Form 1583 walkthrough, a government and bank address-change checklist, and a tracker so nothing keeps going to the old address.';
---
<aside class="kitcta" data-kitcta>
  <p class="kitcta-h">{name}</p>
  <p>{blurb}</p>
  <p><a class="btn" href="/kit/">Get the kit · {price}</a></p>
</aside>
